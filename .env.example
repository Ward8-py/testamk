# AMK London server-side quote delivery
# Copy to .env.local for development. Never expose these values with NEXT_PUBLIC_.

# Resend: verify the sending domain before using a production sender.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
QUOTE_FROM_EMAIL=AMK London <quotes@amkbuildingconstruction.co.uk>
QUOTE_TO_EMAIL=info@amkbuildingconstruction.co.uk

# Comma-separated exact browser origins allowed to submit the quote form.
SITE_URL=https://www.amkbuildingconstruction.co.uk
QUOTE_ALLOWED_ORIGINS=https://www.amkbuildingconstruction.co.uk,https://amkbuildingconstruction.co.uk

# Upstash Redis REST credentials for rate limiting and duplicate suppression.
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# A private random value of at least 24 characters, used to hash IPs and form fingerprints.
QUOTE_HASH_SALT=replace-with-a-long-random-production-secret

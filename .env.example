# =============================================
# AMK London — Environment Variables Template
# Copy this file to .env.local and fill in
# your values. NEVER commit .env.local
# =============================================

# --- Contact Form (choose one service) ---

# Option A: Resend (recommended — resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Option B: EmailJS (client-side, no server needed)
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Option C: Formspree (formspree.io — easiest)
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# --- Analytics (optional) ---
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
